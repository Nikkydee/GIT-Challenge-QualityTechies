                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{dummy_base_url}}/auth/me",
              "host": [
                "{{dummy_base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Get-all-Products-categories",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.test(\"base_url is not hardcoded but defined in the collection\", function () {",
              "    pm.expect(pm.collectionVariables.get(\"dummy_base_url\")).to.exist;",
              "});",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time is less than 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test(\"Response body is an array of category objects\", function () {",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Each category object contains slug, name, and url\", function () {",
              "    jsonData.forEach(function (category) {",
              "        pm.expect(category).to.be.an(\"object\");",
              "        pm.expect(category).to.have.property(\"slug\");",
              "        pm.expect(category).to.have.property(\"name\");",
              "        pm.expect(category).to.have.property(\"url\");",
              "    });",
              "});",
              "",
              "pm.test(\"Category 'groceries' exists\", function () {",
              "    const found = jsonData.some(item => item.slug === \"groceries\");",
              "    pm.expect(found).to.be.true;",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{dummy_base_url}}/products/categories",
          "host": [
            "{{dummy_base_url}}"
          ],
          "path": [
            "products",
            "categories"
          ]
        }
      },
      "response": []
    }
  ],
