      "name": "Get All Products Categories",
      "item": [
        {
          "name": "Positive - GetAllProductsCategories || Valid request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response body is an array of category objects\", function () {",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"There is more than one category\", function () {",
                  "    pm.expect(jsonData.length).to.be.above(1);",
                  "});",
                  "",
                  "pm.test(\"Each category object contains slug, name, and url\", function () {",
                  "    jsonData.forEach(function (category) {",
                  "        pm.expect(category).to.be.an(\"object\");",
                  "        pm.expect(category).to.have.property(\"slug\");",
                  "        pm.expect(category).to.have.property(\"name\");",
                  "        pm.expect(category).to.have.property(\"url\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Each category's slug, name, and url are non-empty strings\", function () {",
                  "    jsonData.forEach(function (category) {",
                  "        pm.expect(category.slug).to.be.a(\"string\").and.to.not.be.empty;",
                  "        pm.expect(category.name).to.be.a(\"string\").and.to.not.be.empty;",
                  "        pm.expect(category.url).to.be.a(\"string\").and.to.not.be.empty;",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Response body matches expected JSON schema\", function () {",
                  "    const schema = {",
                  "        type: \"array\",",
                  "        items: {",
                  "            type: \"object\",",
                  "            properties: {",
                  "                slug: { type: \"string\" },",
                  "                name: { type: \"string\" },",
                  "                url: { type: \"string\" }",
                  "            },",
                  "            required: [\"slug\", \"name\", \"url\"],",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test(\"Category 'groceries' exists\", function () {",
                  "    const found = jsonData.some(item => item.slug === \"groceries\");",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ],
