  "item": [
    {
      "name": "01 - Put - Update Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Product ID is 1\", function () {\r",
              "    const response = \r",
              "        pm.response.json();\r",
              "    pm.expect(response.id).to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Product title was updated\", function () {\r",
              "    const response = \r",
              "    pm.response.json();\r",
              "    pm.expect(response.title).to.eql(\"Update QA Product\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains required product fields\", function () {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(response).to.have.property(\"id\");\r",
              "    pm.expect(response).to.have.property(\"title\");\r",
              "    pm.expect(response).to.have.property(\"price\");\r",
              "    pm.expect(response).to.have.property(\"stock\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "const schema = {\r",
              "    type: \"object\",\r",
              "    required: [\"id\", \"title\", \"price\", \"stock\"],\r",
              "    properties: {\r",
              "        id: { type: \"number\" },\r",
              "        title: { type: \"string\" },\r",
              "        price: { type: \"number\" },\r",
              "        stock: { type: \"number\" }\r",
              "    }\r",
              "};\r",
              "\r",
              "pm.test(\"Response matches product schema\", function () {\r",
              "    pm.response.to.have.jsonSchema(schema);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
